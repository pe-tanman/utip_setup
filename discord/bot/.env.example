# Copy to discord/bot/.env and fill in.
DISCORD_BOT_TOKEN=
# Right-click your server icon -> Copy Server ID (enable Developer Mode in Discord settings first)
DISCORD_GUILD_ID=

# Member API from forms/UTIP_Membership.gs (same values as pipeline/.env)
UTIP_API_URL=
UTIP_API_TOKEN=

# Optional: Luma API key enables /events and the auto event feed + 24h reminders
LUMA_API_KEY=

LINK_FORM=https://forms.gle/REPLACE_ME
LINK_LUMA=https://luma.com/REPLACE_ME
LINK_INSTAGRAM=https://instagram.com/utip_austin
