# Copy to pipeline/.env and fill in. Never commit the real .env (it is git-ignored).

# Member API (forms/UTIP_Membership.gs web-app URL + token printed by setup())
UTIP_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
UTIP_API_TOKEN=

# Luma (requires Luma Plus; calendar settings -> API keys)
LUMA_API_KEY=
LUMA_CALENDAR_URL=https://luma.com/REPLACE_ME
# LUMA_BASE_URL=https://public-api.luma.com
# LUMA_PATHS_JSON={"create_event": "/v1/events/create"}

# Discord: #announcements channel -> Edit channel -> Integrations -> Webhooks
DISCORD_ANNOUNCE_WEBHOOK=
# Right-click the @Member role -> Copy Role ID (Developer Mode on). Leave blank to not ping.
DISCORD_MEMBER_ROLE_ID=

# Instagram Graph API (Professional account linked to a Facebook Page). Optional.
IG_HANDLE=@utip_austin
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional public base URL where exports/ is hosted (needed for auto-posting stories)
IMAGE_BASE_URL=

# Twilio SMS (needs A2P 10DLC or toll-free verification; see docs/sms-setup.md)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
